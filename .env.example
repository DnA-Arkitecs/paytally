# PayTally reads these from the environment. Never commit real values.
# With no Anthropic key, the ledger is built from data/answer-key.json (offline demo).
ANTHROPIC_API_KEY=

# PayPal stays mocked unless PAYPAL_MODE=sandbox and both sandbox keys are set.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

PORT=3000
