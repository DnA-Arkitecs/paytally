{
  "name": "paytally",
  "version": "0.1.0",
  "description": "An AI billing agent for pay-per-result work: it reads a messy work log, applies each client's terms, and invoices through PayPal after one human click.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "eval": "node scripts/eval-extraction.js"
  },
  "keywords": [
    "paypal",
    "invoicing",
    "claude",
    "ag-grid",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "ag-grid-community": "^36.2.0",
    "express": "^5.3.0"
  }
}
